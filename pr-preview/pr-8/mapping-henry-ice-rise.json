 chunks = True, masked = True)\\\n    .rio.clip_box(*drillsite_bounds)\n","key":"QEXFiJtxmy"},{"type":"outputs","id":"hceQnfKu32f13o4Ppmpj_","children":[],"key":"a57Sn2irg1"}],"identifier":"151e08a1","html_id":"151e08a1","key":"vcFfIGcpmu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The full (coarsened) WV image and the two close zooms + GL + radar lines + proposed drill site.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YO425ppfI5"}],"identifier":"the-full-coarsened-wv-image-and-the-two-close-zooms-gl-radar-lines-proposed-drill-site","label":"The full (coarsened) WV image and the two close zooms + GL + radar lines + proposed drill site.","html_id":"the-full-coarsened-wv-image-and-the-two-close-zooms-gl-radar-lines-proposed-drill-site","implicit":true,"key":"Q5zQDTAC6H"}],"identifier":"a836ea43","html_id":"a836ea43","key":"uFm6NS4Giz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(1,3, figsize = (16, 8),)\nWV_close.plot(ax=ax[0], cmap = 'gray', add_colorbar=False)\ngl.boundary.plot(ax=ax[0], color='red', label = 'grounding line')\n\nall_del_positions_near.plot(ax=ax[0], markersize=1,)\nHEnorth_FL5_gdf.plot(ax=ax[0], color='red', markersize=5, label='HEnorth FL5')\ndrillsite_gdf.plot(ax=ax[0], marker = '*', markersize=500, color='blue', label='Drill Site')\n# HEnorth_FL5_gdf.plot(ax=ax[0], color='red', markersize=5, label='radar line')\n# drillsite_gdf.plot(ax=ax[0], marker = '*', markersize=200, color='blue', label='Drill Site')\nax[0].set_ylabel('')\nax[0].set_xlabel('')\n# gl.boundary.plot(ax=ax[0], color='red', label = 'grounding line')\n\nax[0].text(drillsite_bounds[0], drillsite_bounds[1]-1000, 'a')\nax[0].text(crevasses_bounds[0], crevasses_bounds[1]-1000, 'b')\n\nrect1 = Rectangle(\n    (drillsite_bounds[0], drillsite_bounds[1]),      # bottom-left corner, in data coordinates (distance, z)\n    width,     # extent along x\n    height,     # extent along y\n    linewidth=2,\n    edgecolor=\"black\",\n    facecolor=\"none\",\n)\nax[0].add_patch(rect1)\n\nrect2 = Rectangle(\n    (crevasses_bounds[0], crevasses_bounds[1]),      # bottom-left corner, in data coordinates (distance, z)\n    width,     # extent along x\n    height,     # extent along y\n    linewidth=2,\n    edgecolor=\"black\",\n    facecolor=\"none\",\n)\nax[0].add_patch(rect2)\nax[0].set_title('Worldview-1 image from Feb 28 2025')\n# ax[0].legend()\n\n\nWV_drillsite.plot(ax=ax[1], cmap = 'gray', add_colorbar=False)\nHEnorth_FL5_gdf.plot(ax=ax[1], color='red', markersize=5, label='radar line')\ndrillsite_gdf.plot(ax=ax[1], marker = '*', markersize=200, color='blue', label='Drill Site')\nax[1].set_ylabel('')\nax[1].set_xlabel('')\nax[1].set_title('1-km square zoom around drill site')\n\n\nWV_crevasses.plot(ax=ax[2], cmap = 'gray', add_colorbar=False)\nHEnorth_FL5_gdf.plot(ax=ax[2], color='red', markersize=5, label='HEnorth FL5')\ndrillsite_gdf.plot(ax=ax[2], marker = '*', markersize=100, color='blue', label='Drill Site')\nax[2].set_ylabel('')\nax[2].set_xlabel('')\nax[2].set_title('1-km square zoom of crevassed area \\n outside proposed fieldwork region ')\ngl.boundary.plot(ax=ax[2], color='red', label = 'grounding line')\n\nplt.savefig('worldview_crevasse_imagery_1.png', dpi = 300, bbox_inches='tight'  )\n","key":"FpdLG3KFCB"},{"type":"outputs","id":"uDq2ygAkIdFozcwaB1A8F","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"23c99bb650cbb30ff7e895b1ef99cdb0","path":"/PHIRE/pr-preview/pr-8/build/23c99bb650cbb30ff7e895b1ef99cdb0.png"},"text/plain":{"content":"<Figure size 1600x800 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"z9at8qR3cz"}],"key":"itdEDlbAwV"}],"identifier":"27609d06","html_id":"27609d06","key":"AhJs5kkMjf"}],"key":"WZtRvzOtzD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"PHIRE","url":"/","group":"PHIRE"},"next":{"title":"Radargram plotting","url":"/hir-radargram-plotting","group":"Preliminary planning"}}},"domain":"http://localhost:3000"}