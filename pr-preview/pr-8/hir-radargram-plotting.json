e number to vertical distance from the surface\nsample_to_dist = v_ice * sampPeriod / 2;\n","key":"AbLqY2my6x"},{"type":"outputs","id":"Dv--YGQ3h_PGicouYKXIz","children":[],"key":"eyHKbrLmCi"}],"identifier":"e76badbf","html_id":"e76badbf","key":"k2mQ4HDa1w"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the radar data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q6gel2U8wT"}],"identifier":"load-the-radar-data","label":"Load the radar data","html_id":"load-the-radar-data","implicit":true,"key":"INITlmxV5u"}],"identifier":"b4960afb","html_id":"b4960afb","key":"sTNIeEkzx0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"path = '/Users/jkingslake/Documents/papers/WAIS_readvance_Kingslake/files_from_dell_machine/1/HenryFormation/HENORTH_FL5/FinalRadargramForPublication/HENORTH_FL5_2.ASC'\ndata = np.loadtxt(path)  ","key":"BDJda7ifzm"},{"type":"outputs","id":"134mwWAjGEApOedJ4XF54","children":[],"key":"l5eAHEpAy6"}],"identifier":"866f7af9","html_id":"866f7af9","key":"j4ia1DEEyv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the position data and compute distance along the line and an elevation scale","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"duzs7QOwd1"}],"identifier":"load-the-position-data-and-compute-distance-along-the-line-and-an-elevation-scale","label":"Load the position data and compute distance along the line and an elevation scale","html_id":"load-the-position-data-and-compute-distance-along-the-line-and-an-elevation-scale","implicit":true,"key":"CIoeCSebeF"}],"identifier":"8afb9175","html_id":"8afb9175","key":"S3nUgLHr9G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"p_path = '/Users/jkingslake/Documents/papers/WAIS_readvance_Kingslake/files_from_dell_machine/1/HenryFormation/HEnorth_FL5/FinalRadargramForPublication/DBPosFL15.dst'\np = np.loadtxt(p_path)  # shape (7123, 3600)\n\nx = p[:, 2]\ny = p[:, 3]\nh = p[:, 6]\nspacing = np.hypot(x[1:] - x[:-1], y[1:] - y[:-1])\ndistance = np.insert(np.cumsum(spacing),0, 0)\ndistance = distance[-1] - distance  # flip so that distance increases from left to right in the radargram\n# distance = np.flip(distance)  # flip so that distance increases from left to right in the radargram\nelevation_of_peak = h.max()   # useful because sample 0 is at the highest point in the radargram, after the REFLEXW topography correction\nvertical_distance_from_sample0 = sample_to_dist * np.arange(data.shape[0])\nz = elevation_of_peak - vertical_distance_from_sample0","key":"A3gWWn5LXT"},{"type":"outputs","id":"uIHDlOUOPh3bUoISC8X0M","children":[],"key":"nkv718T00m"}],"identifier":"42234a3e","html_id":"42234a3e","key":"qv9OIq6IGn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Put everything into an xarray","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pui4hnU67a"}],"identifier":"put-everything-into-an-xarray","label":"Put everything into an xarray","html_id":"put-everything-into-an-xarray","implicit":true,"key":"YixU5v3Vb5"}],"identifier":"ab12990f","html_id":"ab12990f","key":"ZHKBkdS8jN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"da = xr.DataArray(\n    data,\n    dims=[\"z\", \"distance\"],\n    coords={\"distance\": (('distance'), distance/1000), \n            \"z\": (('z'), z), \n            'x': (('distance'), x), \n            'y': (('distance'), y), \n            'h': (('distance'), h)},\n    name=\"amplitude\",\n)\nda.z.attrs['long_name'] = 'elevation above sea level'\nda.z.attrs['units'] = 'm'\n\nda.x.attrs['long_name'] = 'polar stereographic x coordinate'\nda.x.attrs['units'] = 'm'\n\nda.y.attrs['long_name'] = 'polar stereographic y coordinate'\nda.y.attrs['units'] = 'm'\n\nda.h.attrs['long_name'] = 'surface elevation'\nda.h.attrs['units'] = 'm'\n\nda.distance.attrs['long_name'] = 'distance along radar line'\nda.distance.attrs['units'] = 'km'","key":"HQpBdkkutb"},{"type":"outputs","id":"Rxw7CAVe2QE55fdJvshob","children":[],"key":"byeRWcAClo"}],"identifier":"a11c03b4","html_id":"a11c03b4","key":"vFk1sbeXHB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Flip","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tYirlFgLlT"}],"identifier":"flip","label":"Flip","html_id":"flip","implicit":true,"key":"pD59jzdLoa"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"For consistency with the way I plotted in past papers, I will redefine the distance coordinate so that it is measured from the other end of the radar line.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CwhtuuYiHt"}],"key":"MFFgalPyw2"}],"identifier":"b92248e7","html_id":"b92248e7","key":"Oia4YcDvBf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"da['distance'] = da['distance'][-1] - da['distance']  \nda['distance']","key":"XpHxL2no3z"},{"type":"outputs","id":"_6tkTuxTaM7DcAcdZlXeG","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":14,"metadata":{},"data":{"text/html":{"content":"<div><svg style=\"position: absolute; width: 0; height: 0; overflow: hidden\">\n<defs>\n<symbol id=\"icon-database\" viewBox=