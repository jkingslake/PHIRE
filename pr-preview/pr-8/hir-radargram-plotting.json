x.values\ndrill_y = da_close.sel(distance=drill_distance, method='nearest').y.values\n\nplt.savefig('HEnorth_FL5_with_1drillsite.png', dpi = 300, bbox_inches='tight'   )","key":"euELJYTgcN"},{"type":"outputs","id":"5bwVmbTHhM4AyC72OCIlG","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7d2e8c2e5d5cd8fdeacbd95dd7d159aa","path":"/PHIRE/pr-preview/pr-8/build/7d2e8c2e5d5cd8fdeacbd95dd7d159aa.png"},"text/plain":{"content":"<Figure size 1600x800 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"ANzGbTeCXK"}],"key":"Q2E7ApofEH"}],"identifier":"4ed1d317","html_id":"4ed1d317","key":"hpHz1G00L4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"save the drill site for use in mapping-henry-ice-rise.ipynb","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SBkXEFvQEZ"}],"identifier":"save-the-drill-site-for-use-in-mapping-henry-ice-rise-ipynb","label":"save the drill site for use in mapping-henry-ice-rise.ipynb","html_id":"save-the-drill-site-for-use-in-mapping-henry-ice-rise-ipynb","implicit":true,"key":"sX9kBGVeQ3"}],"identifier":"38d44235","html_id":"38d44235","key":"F0KQdaPYvh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"drillsite_gdf = gpd.GeoDataFrame(geometry=gpd.points_from_xy([drill_x], [drill_y]), crs=\"EPSG:3031\")\ndrillsite_gdf.to_file('drillsite_gdf.geojson', driver='GeoJSON')\ndrillsite_gdf","key":"qUnmkFr1BD"},{"type":"outputs","id":"rgWkntTrNSDxnZje_N_8m","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":20,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody t